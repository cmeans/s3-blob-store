# Inputs for the s3-blob-store Terraform route.
#
# bearer_token_sha256 is the SHA-256 hex digest of the bearer token
# that guards the Lambda Function URL. Only the digest is ever
# supplied to Terraform: the Lambda hashes each presented token and
# compares digests, so the digest sitting in Terraform state cannot
# be used as a credential. The plaintext token is generated by the
# operator, is never written to a file, a template, or chat, and is
# handed to the consuming agent only through the platform's secure
# credential flow when its custom connection is registered.
#
# Supply it at apply time, for example:
#   TF_VAR_bearer_token_sha256=<64 hex chars> terraform apply
# (Compute the digest from the generated token with:
#   printf %s "$TOKEN" | sha256sum )

variable "bearer_token_sha256" {
  description = "SHA-256 hex digest of the Lambda front-door bearer token."
  type        = string
  sensitive   = true

  validation {
    condition     = can(regex("^[0-9a-f]{64}$", var.bearer_token_sha256))
    error_message = "Must be a lowercase SHA-256 hex digest (64 characters)."
  }
}

variable "region" {
  description = "AWS region for the store's resources."
  type        = string
  default     = "us-east-2"
}

variable "name_suffix" {
  description = "Optional suffix appended to the derived blob bucket name only. Leave empty normally. It does not make a second Terraform store possible in the same account: the IAM role name is fixed and account-wide."
  type        = string
  default     = ""

  # The same pattern as the template's NameSuffix parameter.
  validation {
    condition     = can(regex("^$|^[a-z0-9][a-z0-9-]{0,19}[a-z0-9]$|^[a-z0-9]$", var.name_suffix))
    error_message = "Must be empty, or 1-21 lowercase letters, digits and hyphens, starting and ending with a letter or digit."
  }
}

variable "reserved_concurrency" {
  description = "Optional cap on how many copies of the function run at once. 0 (the default) sets no cap: here 0 means \"not set\", unlike the provider's own reserved_concurrent_executions = 0, which stops every call. Calls past the cap get HTTP 429. AWS refuses a cap that would cut into the concurrency it keeps unreserved (100 by its documentation; on an account whose limit was 10, it refused any cap), so on an account with a low concurrency quota leave this at 0."
  type        = number
  default     = 0
  nullable    = false

  # The same range as the template's ReservedConcurrency parameter.
  validation {
    condition     = var.reserved_concurrency == floor(var.reserved_concurrency) && var.reserved_concurrency >= 0 && var.reserved_concurrency <= 9999
    error_message = "Must be 0, or a whole number from 1 to 9999."
  }
}
